{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "name": "trophy-2",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}