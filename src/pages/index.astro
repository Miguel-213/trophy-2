---
import { supabase } from '../lib/supabase'

const { data: trofeos, error } = await supabase
  .from('trofeos')
  .select('*')
  .order('id')
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Trophy 2</title>
  </head>

  <body>
    <h1>Trofeos</h1>

    {
      error ? (
        <p>Error al cargar los trofeos: {error.message}</p>
      ) : (
        <ul>
          {
            trofeos?.map((trofeo) => (
              <li>
                {trofeo.nombre} - {trofeo.juego}
              </li>
            ))
          }
        </ul>
      )
    }
  </body>
</html>